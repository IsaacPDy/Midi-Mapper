{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MIDI Mapper",
  "version": "0.1.0",
  "identifier": "app.midimapper.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MIDI Mapper",
        "width": 1040,
        "height": 760,
        "minWidth": 780,
        "minHeight": 560,
        "backgroundColor": "#10191d"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
